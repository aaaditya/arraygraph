generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooled URL for queries; unpooled for migrations (same as DATABASE_URL locally).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Auth (NextAuth / Auth.js adapter models) ────────────────────────────────

enum Role {
  LEARNER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  username       String?   @unique
  bio            String?   @db.VarChar(280)
  role           Role      @default(LEARNER)
  dailyGoalXp    Int       @default(30)
  timezone       String    @default("Asia/Kolkata")
  /// Bumped on "sign out everywhere" and password change so old JWTs stop refreshing.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  authTokens         AuthToken[]
  lessonProgress     LessonProgress[]
  xpEvents           XpEvent[]
  dailyActivity      DailyActivity[]
  streak             Streak?
  reviewItems        ReviewItem[]
  quizResults        QuizResult[]
  problemAttempts    ProblemAttempt[]
  codeDrafts         CodeDraft[]
  problemSubmissions ProblemSubmission[]
  badges             UserBadge[]
  designBoards       DesignBoard[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Hashed one-time tokens for email verification and password reset.
model AuthToken {
  id         String           @id @default(cuid())
  userId     String?
  identifier String
  tokenHash  String           @unique
  purpose    AuthTokenPurpose
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
}

// ─── Learning progress ──────────────────────────────────────────────────────

enum LessonStatus {
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id              String       @id @default(cuid())
  userId          String
  lessonSlug      String
  status          LessonStatus @default(IN_PROGRESS)
  /// Heading id / TOC slug the learner last viewed.
  lastSection     String?
  scrollPosition  Int          @default(0)
  /// Opaque JSON snapshot for embedded visualizers (step index, etc.).
  visualizerState Json?
  /// Quiz answer drafts keyed by question id.
  quizState       Json?
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
  @@index([userId, updatedAt])
}

enum XpReason {
  LESSON
  PROBLEM
  QUIZ
  STREAK_BONUS
  REVIEW
}

/// One row per XP award. The unique key makes awards idempotent.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    XpReason
  refId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
}

/// Per-day rollup used for daily goals, streaks and the activity heatmap.
model DailyActivity {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  xp               Int      @default(0)
  lessonsCompleted Int      @default(0)
  problemsSolved   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Streak {
  id             String    @id @default(cuid())
  userId         String    @unique
  current        Int       @default(0)
  longest        Int       @default(0)
  lastActiveDate DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ReviewItemType {
  LESSON
  QUIZ
  PROBLEM
}

/// Spaced repetition schedule (stage 0..3 → 1, 3, 7, 21 days).
model ReviewItem {
  id             String         @id @default(cuid())
  userId         String
  itemType       ReviewItemType
  itemId         String
  stage          Int            @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, dueAt])
}

/// Latest quiz attempt / result for a quiz.
model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  total     Int
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId, updatedAt])
}

/// Aggregate problem practice state (attempts + best result).
model ProblemAttempt {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  language  String
  code      String   @db.Text
  passed    Boolean  @default(false)
  attempts  Int      @default(0)
  bestTime  Int?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, language])
  @@index([userId, updatedAt])
}

/// Autosaved code draft per problem and language (may differ from last attempt).
model CodeDraft {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  language  String
  code      String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, language])
}

/// Immutable submission history (kept for later pattern practice).
model ProblemSubmission {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  language    String
  code        String   @db.Text
  passed      Boolean
  passedCount Int
  totalCount  Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ─── System design studio ───────────────────────────────────────────────────

model DesignBoard {
  id          String   @id @default(cuid())
  userId      String
  caseStudyId String
  title       String
  /// React Flow nodes and edges
  graph       Json
  /// Self-review checklist state
  checklist   Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, caseStudyId])
}

// ─── Coming soon ────────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  feature   String   @default("ai-mock-interview")
  createdAt DateTime @default(now())
}
