# Copy to .env and adjust. Every variable is validated at startup by src/env.ts.

# PostgreSQL connection string
DATABASE_URL="postgresql://visualdsa:visualdsa@localhost:5432/visualdsa?schema=public"

# Auth.js / NextAuth. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-plus-character-random-string"
# Set to true when running behind a proxy or with `next start` locally
AUTH_TRUST_HOST="true"

# Optional OAuth providers. They are enabled automatically when both values are set.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI Mock Interview is Coming Soon. Keep false; no AI API key is needed.
FEATURE_AI_MOCK="false"

# Public URL used for SEO metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional email delivery. Leave blank to log verification/reset links to the console.
RESEND_API_KEY=""
MAIL_FROM="VisualDSA <onboarding@resend.dev>"
