    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
